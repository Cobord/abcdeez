# Web Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Database Configuration
DATABASE_URL=sqlite:./data/app.db  # For production, use PostgreSQL: postgresql://user:pass@host/dbname
REDIS_URL=redis://127.0.0.1:6379

# Server Configuration
PORT=3000
ENVIRONMENT=development  # Options: development, staging, production
SERVER_NAME=localhost

# Security Configuration
# JWT_SECRET must be at least 64 characters, randomly generated
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64_TO_GENERATE
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# CORS Configuration
# In production, set to your actual frontend URL
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# Session Configuration
SESSION_TIMEOUT_HOURS=24
REQUIRE_STRONG_PASSWORDS=true

# Logging and Monitoring
LOG_LEVEL=info  # Options: trace, debug, info, warn, error
METRICS_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30
# TRACING_ENDPOINT=https://your-tracing-endpoint.com  # Optional

# Privacy Configuration
PRIVACY_EPSILON=1.0
PRIVACY_DELTA=0.000000001
PRIVACY_WINDOW_HOURS=24

# Apple OAuth Configuration (Required for Apple Sign In)
# Leave empty in development, required in production if using Apple auth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=

# GitHub OAuth Configuration (Required for GitHub Sign In)
# Leave empty in development, required in production if using GitHub auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# TLS/SSL Configuration
# TLS_DOMAIN=yourdomain.com  # Optional
TLS_USE_LETSENCRYPT=false
TLS_PORT=443
# ADMIN_EMAIL=admin@yourdomain.com  # Optional, for Let's Encrypt notifications

# Important Security Notes:
# 1. Generate strong, unique secrets for production
# 2. Use environment-specific values (don't reuse between environments)
# 3. Rotate secrets regularly
# 4. Never use default or placeholder values in production
# 5. Store production secrets in a secure secrets management system
# 6. Ensure file permissions are restrictive (chmod 600 .env)