# Python Client Docker Image
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy Python client
COPY python-client/ ./

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Install additional scientific computing packages
RUN pip install --no-cache-dir \
    jupyter \
    numpy \
    pandas \
    matplotlib \
    seaborn \
    scipy \
    scikit-learn \
    requests

# Create user
RUN useradd -r -u 1001 app && chown -R app:app /app

# Switch to app user
USER app

# Create data directory
RUN mkdir -p /app/data /app/notebooks

# Expose Jupyter port
EXPOSE 8888

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import abcdeez; print('OK')" || exit 1

# Default command runs Jupyter lab
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token=''"]