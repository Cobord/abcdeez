target/

# Node modules
node_modules/
**/node_modules/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Logs
*.log
logs/

# Test files
test.db*
*.test

# Temporary files
*.tmp
*.temp
/tmp/

# Local configuration
.env
.env.local
config.local.toml
backend.local.toml

# User data
user_data/
audio_recordings/
irb_documents/

# Database files
*.db
*.db-shm
*.db-wal

# Documentation build artifacts
book/build/
**/book/build/

# macOS specific
.DS_Store
._*

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux specific
*~
.directory

# Rust specific
Cargo.lock (keep only root one)
**/.cargo/

# Python specific
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
